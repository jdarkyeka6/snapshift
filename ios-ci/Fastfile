# SnapShift Fastlane: NEVER revoke or delete any distribution certificates.
APP_IDENTIFIER = "com.jdarkyeka6.snapshift"
APP_VERSION = "1.0"
default_platform(:ios)
platform :ios do
  desc "Build, safely sign and upload SnapShift"
  lane :beta do
    missing = %w[ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_CONTENT].select do |key|
      ENV.fetch(key, "").strip.empty?
    end
    UI.user_error!("Missing Apple secrets: #{missing.join(', ')}") unless missing.empty?

    require "base64"
    require "securerandom"
    raw = ENV.fetch("ASC_KEY_CONTENT").strip
    pem = raw.include?("BEGIN PRIVATE KEY") ? raw : Base64.decode64(raw)
    UI.user_error!("ASC_KEY_CONTENT must contain the .p8 private key (PEM or base64).") unless pem.include?("BEGIN PRIVATE KEY")
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID").strip,
      issuer_id: ENV.fetch("ASC_ISSUER_ID").strip,
      key_content: pem,
      is_key_content_base64: false
    )

    require "spaceship"
    unless Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
      UI.user_error!("SnapShift's App Store Connect app was not found: #{APP_IDENTIFIER}")
    end

    name = "snapshift-ci"
    password = SecureRandom.hex(32)
    create_keychain(
      name: name, password: password,
      default_keychain: true, unlock: true,
      timeout: 3600, lock_when_sleeps: false
    )

    # New GitHub macOS runners don't have the private key for existing certificates.
    # Fastlane may create a new distribution cert only when Apple's quota permits.
    # NO certificate deletion or revocation, even when the quota is full.
    begin
      cert(
        api_key: api_key, generate_apple_certs: true,
        keychain_path: File.expand_path("~/Library/Keychains/#{name}-db"),
        keychain_password: password
      )
    rescue => e
      if e.message.match?(/maximum|limit|too many|quota|certificate count/i)
        UI.user_error!(
          "Apple's distribution certificate quota is full. No certificate was revoked. " \
          "Use an existing certificate WITH its private key or carefully free a slot yourself."
        )
      end
      raise
    end

    # App-specific provisioning only.
    sigh(api_key: api_key, app_identifier: APP_IDENTIFIER, force: true)
    profile = lane_context[SharedValues::SIGH_NAME].to_s
    UI.user_error!("SnapShift provisioning profile generation failed.") if profile.empty?
    # The generated profile provides the team ID, so no fourth secret is needed.
    require "open3"
    require "plist"
    profile_path = lane_context[SharedValues::SIGH_PROFILE_PATH].to_s
    UI.user_error!("SnapShift profile path was not returned by Fastlane.") if profile_path.empty?
    decoded, result = Open3.capture2e("security", "cms", "-D", "-i", profile_path)
    UI.user_error!("Could not decode SnapShift's provisioning profile.") unless result.success?
    profile_data = Plist.parse_xml(decoded)
    team_id = Array(profile_data.fetch("TeamIdentifier", [])).first.to_s
    UI.user_error!("Apple Team ID was not found in SnapShift's provisioning profile.") unless team_id.match?(/\A[A-Z0-9]{10}\z/)
    UI.message("Using the Apple Developer Team ID from SnapShift's provisioning profile.")
    update_code_signing_settings(
      path: "App.xcodeproj", use_automatic_signing: false,
      team_id: team_id, code_sign_identity: "Apple Distribution",
      profile_name: profile, targets: ["App"]
    )

    increment_version_number(xcodeproj: "App.xcodeproj", version_number: APP_VERSION)
    last_build = latest_testflight_build_number(
      api_key: api_key, app_identifier: APP_IDENTIFIER,
      version: APP_VERSION, initial_build_number: 0
    )
    build_number = last_build.to_i + 1
    increment_build_number(xcodeproj: "App.xcodeproj", build_number: build_number)
    UI.message("SnapShift #{APP_VERSION} (#{build_number})")
    build_app(
      project: "App.xcodeproj", scheme: "App", export_method: "app-store",
      export_options: {
        signingStyle: "manual", teamID: team_id,
        provisioningProfiles: {APP_IDENTIFIER => profile}
      }
    )
    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true)
    UI.success("Build uploaded. Apple must process it before it appears in TestFlight.")
  end
end
